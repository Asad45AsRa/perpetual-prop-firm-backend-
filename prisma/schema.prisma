// =====================================================================
// Perpetual Prop Firm - database schema (PostgreSQL)
// Rules:
//  * All money / price / size values are Decimal, never Float.
//  * TradingAccount.balance is a cached value. It may ONLY be changed
//    through ledger.service.ts, which writes a LedgerEntry for every
//    change. Never update the balance directly anywhere else.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums ---------------------------------

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// Which end-user dashboards a USER can open. One person can be both a trader and an affiliate.
enum Portal {
  TRADER
  AFFILIATE
}

// Per-section admin access (frontend: none / view / manage; "none" = no row).
enum AccessLevel {
  VIEW
  MANAGE
}

enum EmailTokenType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum AccountStage {
  CHALLENGE
  FUNDED
}

enum AccountStatus {
  ACTIVE
  PASSED
  BREACHED
  DISABLED
}

enum DailyLossMethod {
  BALANCE_BASED
  EQUITY_BASED
}

enum DrawdownType {
  STATIC
  TRAILING
}

enum PurchaseStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  NEEDS_REVIEW
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  // Entry stop: opens a position when the trigger price is touched
  STOP_MARKET
  // Exit orders attached to an open position (always reduce-only)
  TAKE_PROFIT
  STOP_LOSS
}

// NEW = resting limit or armed trigger order, PARTIALLY_FILLED = still working with a filled part.
enum OrderStatus {
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
}

enum TimeInForce {
  GTC
  IOC
}

// ONE_WAY: one net position per market. HEDGE: independent long and short per market.
enum PositionMode {
  ONE_WAY
  HEDGE
}

// Decides the fee group (see trading/engine/fees.ts) and the default leverage cap.
enum MarketType {
  CRYPTO
  EQUITY
  COMMODITY
  INDEX
  FX
}

enum Liquidity {
  MAKER
  TAKER
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum LedgerType {
  DEPOSIT
  REALIZED_PNL
  FEE
  FUNDING
  PAYOUT
  ADJUSTMENT
}

enum RiskEventType {
  DAILY_LOSS_BREACH
  MAX_DRAWDOWN_BREACH
  PROFIT_TARGET_REACHED
  LIQUIDATION
  STALE_PRICE_BLOCK
  MANUAL_LOCK
}

// Trading behaviour that harms the firm. A flag is only a finding for staff review, never an automatic punishment.
enum AbuseFlagType {
  CROSS_ACCOUNT_HEDGE
  COPY_TRADING
  LATENCY_ABUSE
}

enum AbuseFlagStatus {
  OPEN
  CONFIRMED
  DISMISSED
}

// Technical breach review (Rulebook PE-1.1: the trader has 72 hours to ask for it)
enum BreachReviewStatus {
  OPEN
  APPROVED
  REJECTED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  SENT
  CONFIRMED
  FAILED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

// ------------------------------ Users --------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  // Staff only. Customers sign in with an email code or Google (no password).
  passwordHash    String?
  // Customer profile (onboarding username + avatar steps, Settings page)
  username        String?   @unique
  avatar          String?
  leaderboardPublic Boolean @default(true)
  // Staff display name (Staff & Permissions page)
  displayName     String?
  // Affiliate join: where the affiliate promotes (Instagram / Meta / TikTok) and their handle there
  signupPlatform  String?
  signupHandle    String?
  // Google sign-in subject (stable Google account id)
  googleSub       String?   @unique
  lastLoginAt     DateTime?
  // Any access token issued before this moment is rejected (force sign-out, suspend, role change).
  tokensValidAfter DateTime?
  // Optimistic locking for staff edits (409 when two admins edit at once)
  version         Int       @default(1)
  createdByEmail  String?
  role            Role      @default(USER)
  // End-user portals (ignored for staff). Signing up gives TRADER; joining the affiliate program adds AFFILIATE.
  portals         Portal[]  @default([TRADER])
  // Set when an admin edits portals by hand: sign-in flows then stop auto-adding portals.
  portalsManagedByAdmin Boolean @default(false)
  isActive        Boolean   @default(true)
  // The first super admin is protected: nobody can delete or demote it.
  isProtected     Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  mfaEnabled      Boolean   @default(false)
  // AES-GCM encrypted TOTP secret (see utils/encryption.ts)
  mfaSecret       String?
  referralCode    String    @unique
  referredById    String?   @db.Uuid
  referredBy      User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]    @relation("Referrals")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  permissions    StaffPermission[]
  rights         StaffRight[]
  emailTokens    EmailToken[]
  refreshTokens  RefreshToken[]
  purchases      Purchase[]
  accounts       TradingAccount[]
  payouts        Payout[]
  commissions    Commission[]     @relation("AffiliateCommissions")
  auditLogs      AuditLog[]

  @@index([role])
}

// Section-by-section access for ADMIN and MODERATOR users (section keys = admin sidebar pages,
// see src/modules/rbac/rbac.catalog.ts). SUPER_ADMIN always has MANAGE on everything.
model StaffPermission {
  id      String      @id @default(uuid()) @db.Uuid
  userId  String      @db.Uuid
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  section String
  level   AccessLevel @default(VIEW)

  @@unique([userId, section])
}

// Special rights for sensitive actions (approve payouts, kill switches...). Granted one by one,
// independent of section level, so MANAGE on a page never silently allows moving money.
model StaffRight {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  right  String

  @@unique([userId, right])
}

// Passwordless sign-in: 6-digit code emailed to the address. Stored hashed; max 5 attempts.
// "meta" keeps what the sign-up form sent (portal, referral, platform, handle) until the code is confirmed.
model LoginCode {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String
  meta      Json?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, type])
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  // Remembers whether this session passed MFA (staff accounts)
  mfaVerified Boolean   @default(false)
  // Device info for the "Active devices" list
  userAgent   String?
  ip          String?
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ------------------------- Plans & purchases -------------------------

model Plan {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  accountSize      Decimal         @db.Decimal(20, 8)
  price            Decimal         @db.Decimal(20, 8)
  // All percentages are stored as plain numbers: 10 means 10 percent
  profitTargetPct  Decimal         @db.Decimal(10, 4)
  dailyLossPct     Decimal         @db.Decimal(10, 4)
  maxDrawdownPct   Decimal         @db.Decimal(10, 4)
  maxLeverage      Int             @default(20)
  // Account-wide gross exposure cap as a multiple of CURRENT equity (spec: 10 for evaluation / funded models, 3 for Instant)
  grossExposureMultiple Int        @default(10)
  minTradingDays   Int             @default(0)
  // Calculation methods must be confirmed with the client
  dailyLossMethod  DailyLossMethod @default(BALANCE_BASED)
  drawdownType     DrawdownType    @default(STATIC)
  isActive         Boolean         @default(true)
  // Rule version. A plan that is already used by accounts or purchases is never edited in place: a rule change creates a new
  // row with ruleVersion + 1 (supersedesId = the old row), so every existing account keeps the rules it was bought with.
  ruleVersion      Int             @default(1)
  supersedesId     String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  purchases Purchase[]
  accounts  TradingAccount[]
}

model Purchase {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  user              User           @relation(fields: [userId], references: [id])
  planId            String         @db.Uuid
  plan              Plan           @relation(fields: [planId], references: [id])
  amount            Decimal        @db.Decimal(20, 8)
  currency          String         @default("USD")
  status            PurchaseStatus @default(PENDING)
  // Plisio invoice reference. Unique so one invoice maps to one purchase.
  plisioTxnId       String?        @unique
  plisioInvoiceUrl  String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // One purchase can create at most ONE trading account (unique FK below)
  tradingAccount TradingAccount?
  commission     Commission?

  @@index([userId])
  @@index([status, createdAt])
}

// --------------------------- Trading accounts ------------------------

model TradingAccount {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id])
  planId           String        @db.Uuid
  plan             Plan          @relation(fields: [planId], references: [id])
  // The purchase that created this account. Unique = no duplicate activation.
  purchaseId       String?       @unique @db.Uuid
  purchase         Purchase?     @relation(fields: [purchaseId], references: [id])
  // Funded accounts point back to the challenge account that created them
  sourceAccountId  String?       @db.Uuid
  stage            AccountStage  @default(CHALLENGE)
  status           AccountStatus @default(ACTIVE)
  startingBalance  Decimal       @db.Decimal(20, 8)
  // Cached balance. Only ledger.service.ts may change it.
  balance          Decimal       @default(0) @db.Decimal(20, 8)
  highWaterMark    Decimal       @default(0) @db.Decimal(20, 8)
  dayStartEquity   Decimal       @default(0) @db.Decimal(20, 8)
  dayStartBalance  Decimal       @default(0) @db.Decimal(20, 8)
  lastDailyResetAt DateTime?
  statusReason     String?
  // Can only be changed while the account is flat (no positions, no working orders).
  positionMode     PositionMode  @default(ONE_WAY)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orders        Order[]
  fills         Fill[]
  positions     Position[]
  ledgerEntries LedgerEntry[]
  riskEvents    RiskEvent[]
  payouts       Payout[]
  fundingPayments FundingPayment[]
  dailySnapshots DailyRiskSnapshot[]
  abuseFlags    AbuseFlag[]
  breachReviews BreachReview[]

  @@index([userId])
  @@index([status])
}

// Market registry. A market only trades when it is enabled AND the live feed is healthy.
// Limits that the owner must verify (maxNotionalUsd, caps per symbol) are editable from the admin panel.
model Market {
  id             String   @id @default(uuid()) @db.Uuid
  symbol         String   @unique
  baseAsset      String
  // Exact Hyperliquid coin key used for market data (HIP-3 prefixes are kept, never stripped)
  hlKey          String   @unique
  marketType     MarketType @default(CRYPTO)
  // Size decimals from Hyperliquid metadata
  szDecimals     Int
  // Price decimals allowed for this market (6 - szDecimals for perps)
  pricePrecision Int
  // Smallest allowed price increment (10 ^ -pricePrecision)
  priceTick      Decimal  @default(0) @db.Decimal(28, 10)
  // Order size must be a multiple of this step (10 ^ -szDecimals)
  sizeStep       Decimal  @default(0) @db.Decimal(28, 10)
  minSize        Decimal  @db.Decimal(28, 10)
  // Smallest order value (Hyperliquid itself rejects orders below 10 USD)
  minNotionalUsd Decimal  @default(10) @db.Decimal(20, 8)
  // Max open notional per symbol and side, per account. Null = no per-symbol cap (gross overlay still applies).
  maxNotionalUsd Decimal? @db.Decimal(20, 8)
  maxLeverage    Int
  // Optional per-market fee overrides. Null = use the fee group default.
  makerFeeRate   Decimal? @db.Decimal(12, 8)
  takerFeeRate   Decimal? @db.Decimal(12, 8)
  // Resting limit orders also need the mark price to cross the limit before they fill.
  requireMarkConfirm Boolean @default(false)
  fundingSupported Boolean @default(true)
  // Bumped whenever limits or fees change, stored on every fill for dispute checks.
  riskTierVersion String  @default("v1")
  isEnabled      Boolean  @default(false)
  isHalted       Boolean  @default(false)
  // Existing positions may be reduced, but no new exposure is accepted.
  isCloseOnly    Boolean  @default(false)
  // Set when Hyperliquid reports the contract as delisted.
  delistedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders    Order[]
  fills     Fill[]
  positions Position[]
  fundingRates FundingRate[]
  fundingPayments FundingPayment[]
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  accountId     String      @db.Uuid
  account       TradingAccount @relation(fields: [accountId], references: [id])
  marketId      String      @db.Uuid
  market        Market      @relation(fields: [marketId], references: [id])
  // Client supplied key. Prevents duplicate orders on retries.
  clientOrderId String?
  side          OrderSide
  type          OrderType   @default(MARKET)
  status        OrderStatus @default(NEW)
  size          Decimal     @db.Decimal(28, 10)
  limitPrice    Decimal?    @db.Decimal(28, 10)
  filledSize    Decimal     @default(0) @db.Decimal(28, 10)
  avgFillPrice  Decimal?    @db.Decimal(28, 10)
  leverage      Int
  reduceOnly    Boolean     @default(false)
  rejectReason  String?
  // Hedge mode: which position leg the order targets (also used by TP/SL in one-way mode)
  positionSide  PositionSide?
  timeInForce   TimeInForce @default(GTC)
  // Rejected instead of filled as taker when it would cross the book at placement
  postOnly      Boolean     @default(false)
  // STOP_MARKET / TAKE_PROFIT / STOP_LOSS trigger price
  triggerPrice  Decimal?    @db.Decimal(28, 10)
  // Exit that always closes the whole current position (size follows the position)
  closePosition Boolean     @default(false)
  // Set when a trigger order fired and is now working against the book
  triggeredAt   DateTime?
  // Max allowed slippage for opening market orders, percent (3 = 3 percent)
  maxSlippagePct Decimal?   @db.Decimal(10, 4)
  // Margin + fee buffer held for the unfilled part of a resting opening order
  reservedMargin Decimal    @default(0) @db.Decimal(20, 8)
  cancelReason  String?
  // Resting limit orders only: the server cancels the order at this time (expiry GTC / 5m / 1h / 24h / 30d)
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  fills Fill[]

  @@unique([accountId, clientOrderId])
  @@index([accountId, createdAt])
  @@index([marketId, status])
  @@index([accountId, status])
  @@index([status, expiresAt])
}

model Fill {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id])
  accountId   String    @db.Uuid
  account     TradingAccount @relation(fields: [accountId], references: [id])
  marketId    String    @db.Uuid
  market      Market    @relation(fields: [marketId], references: [id])
  side        OrderSide
  price       Decimal   @db.Decimal(28, 10)
  size        Decimal   @db.Decimal(28, 10)
  fee         Decimal   @db.Decimal(20, 8)
  realizedPnl Decimal   @default(0) @db.Decimal(20, 8)
  liquidity   Liquidity @default(TAKER)
  // Fee rate that was applied (maker or taker), kept for audits
  feeRate     Decimal   @default(0) @db.Decimal(12, 8)
  positionSide PositionSide?
  // Order book levels that were consumed: [[price, size], ...]. Proof for dispute checks.
  bookLevels  Json?
  // Time of the order book snapshot used for this fill
  bookTime    DateTime?
  rulesVersion String?
  createdAt   DateTime  @default(now())

  @@index([accountId, createdAt])
}

// One row per account + market + side. In ONE_WAY mode only one side has size at a time,
// in HEDGE mode both can. A closed position keeps its row with size 0 and status CLOSED,
// and is reused when reopened. "margin" is the initial margin (cross margin accounting).
model Position {
  id               String         @id @default(uuid()) @db.Uuid
  accountId        String         @db.Uuid
  account          TradingAccount @relation(fields: [accountId], references: [id])
  marketId         String         @db.Uuid
  market           Market         @relation(fields: [marketId], references: [id])
  side             PositionSide
  size             Decimal        @default(0) @db.Decimal(28, 10)
  entryPrice       Decimal        @default(0) @db.Decimal(28, 10)
  markPrice        Decimal        @default(0) @db.Decimal(28, 10)
  leverage         Int            @default(1)
  margin           Decimal        @default(0) @db.Decimal(20, 8)
  liquidationPrice Decimal?       @db.Decimal(28, 10)
  status           PositionStatus @default(OPEN)
  openedAt         DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([accountId, marketId, side])
  @@index([status])
  @@index([marketId, status])
}

// Append-only. Every balance change of a trading account is one row.
model LedgerEntry {
  id             String         @id @default(uuid()) @db.Uuid
  accountId      String         @db.Uuid
  account        TradingAccount @relation(fields: [accountId], references: [id])
  type           LedgerType
  // Signed amount: positive credits the account, negative debits it
  amount         Decimal        @db.Decimal(20, 8)
  balanceAfter   Decimal        @db.Decimal(20, 8)
  refType        String?
  refId          String?
  // Makes retries safe: the same key can never be posted twice
  idempotencyKey String?        @unique
  description    String?
  createdAt      DateTime       @default(now())

  @@index([accountId, createdAt])
}

model RiskEvent {
  id        String         @id @default(uuid()) @db.Uuid
  accountId String         @db.Uuid
  account   TradingAccount @relation(fields: [accountId], references: [id])
  type      RiskEventType
  details   Json?
  createdAt DateTime       @default(now())

  @@index([accountId, createdAt])
  @@index([type])
}

// One immutable row per account and UTC trading day (kind DAILY), plus one row per payout rebase (kind PAYOUT_REBASE:<payoutId>).
// The unique key makes a repeated or late scheduler run, and a repeated payout event, harmless.
model DailyRiskSnapshot {
  id              String         @id @default(uuid()) @db.Uuid
  accountId       String         @db.Uuid
  account         TradingAccount @relation(fields: [accountId], references: [id])
  tradingDate     DateTime       @db.Date
  kind            String
  startingBalance Decimal        @db.Decimal(20, 8)
  // Realized balance at the UTC day boundary (rebuilt from the ledger, not from the time the job ran)
  dayStartBalance Decimal        @db.Decimal(20, 8)
  dayStartEquity  Decimal        @db.Decimal(20, 8)
  dailyAllowance  Decimal        @db.Decimal(20, 8)
  dailyFloor      Decimal        @db.Decimal(20, 8)
  staticFloor     Decimal        @db.Decimal(20, 8)
  payoutId        String?        @db.Uuid
  createdAt       DateTime       @default(now())

  @@unique([accountId, tradingDate, kind])
  @@index([accountId, createdAt])
}

// A finding about suspicious trading (hedging between accounts, copy trading, latency abuse) waiting for a staff decision.
model AbuseFlag {
  id                String          @id @default(uuid()) @db.Uuid
  type              AbuseFlagType
  status            AbuseFlagStatus @default(OPEN)
  accountId         String          @db.Uuid
  account           TradingAccount  @relation(fields: [accountId], references: [id])
  relatedAccountIds String[]        @default([])
  summary           String
  evidence          Json
  // Same finding twice = same key (a scan or a retry never creates a duplicate)
  dedupeKey         String          @unique
  reviewedById      String?         @db.Uuid
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime        @default(now())

  @@index([status, createdAt])
  @@index([accountId])
}

// Request of a trader to review a breach (inaccurate data, outage, duplicate fill, software fault). One per breach event.
model BreachReview {
  id             String             @id @default(uuid()) @db.Uuid
  accountId      String             @db.Uuid
  account        TradingAccount     @relation(fields: [accountId], references: [id])
  riskEventId    String             @unique @db.Uuid
  requestedById  String             @db.Uuid
  reason         String
  // Copy of the breach evidence (equity, floors, marks) taken when the review was opened
  evidence       Json?
  status         BreachReviewStatus @default(OPEN)
  deadlineAt     DateTime
  requestedAt    DateTime           @default(now())
  resolvedById   String?            @db.Uuid
  resolvedAt     DateTime?
  resolutionNote String?

  @@index([status, requestedAt])
  @@index([accountId])
}

// ------------------------------ Funding ------------------------------

// Hourly funding rate of a market, copied from Hyperliquid. One row per market and UTC hour.
model FundingRate {
  id        String   @id @default(uuid()) @db.Uuid
  marketId  String   @db.Uuid
  market    Market   @relation(fields: [marketId], references: [id])
  // Start of the UTC hour the rate belongs to
  hourStart DateTime
  rate      Decimal  @db.Decimal(20, 12)
  source    String   @default("hyperliquid")
  createdAt DateTime @default(now())

  @@unique([marketId, hourStart])
}

// One funding charge or credit per open position and UTC hour (replay safe through the unique key).
// Created at the hour boundary with amount = null (rate pending) and completed once the rate is known.
model FundingPayment {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @db.Uuid
  account     TradingAccount @relation(fields: [accountId], references: [id])
  positionId  String         @db.Uuid
  marketId    String         @db.Uuid
  market      Market         @relation(fields: [marketId], references: [id])
  hourStart   DateTime
  side        PositionSide
  size        Decimal        @db.Decimal(28, 10)
  // Oracle price at the boundary (Hyperliquid oraclePx)
  oraclePrice Decimal?       @db.Decimal(28, 10)
  rate        Decimal?       @db.Decimal(20, 12)
  // Signed: negative = the account paid, positive = the account received
  amount      Decimal?       @db.Decimal(20, 8)
  appliedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@unique([positionId, hourStart])
  @@index([appliedAt])
  @@index([accountId, hourStart])
}

// ------------------------ Payouts & affiliates -----------------------

model Payout {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id])
  accountId     String       @db.Uuid
  account       TradingAccount @relation(fields: [accountId], references: [id])
  amount        Decimal      @db.Decimal(20, 8)
  asset         String
  network       String
  walletAddress String
  status        PayoutStatus @default(REQUESTED)
  txHash        String?
  explorerUrl   String?
  reviewedById  String?      @db.Uuid
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

model Commission {
  id              String           @id @default(uuid()) @db.Uuid
  affiliateUserId String           @db.Uuid
  affiliate       User             @relation("AffiliateCommissions", fields: [affiliateUserId], references: [id])
  // Unique: one commission per purchase
  purchaseId      String           @unique @db.Uuid
  purchase        Purchase         @relation(fields: [purchaseId], references: [id])
  amount          Decimal          @db.Decimal(20, 8)
  status          CommissionStatus @default(PENDING)
  createdAt       DateTime         @default(now())

  @@index([affiliateUserId])
}

// ------------------------- Platform & content ------------------------

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// Editable content shown on the public site (for example faq and rules)
model ContentBlock {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  title       String?
  data        Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// Business values that must be configurable, not hard coded
// (fees, spread, payout rules, affiliate commission, and so on)
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}